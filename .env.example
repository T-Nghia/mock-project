# Copy this file to .env and adjust as needed.

# --- Database ---
POSTGRES_USER=slrms
POSTGRES_PASSWORD=slrms_password
POSTGRES_DB=slrms
DATABASE_URL=postgresql+psycopg2://slrms:slrms_password@db:5432/slrms

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET_KEY=super-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Optional bootstrap account. Set both values or leave both empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional: enable real LLM-based RAG answers & AI suggested questions ---
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIM=384
GEMINI_EMBEDDING_BATCH_TOKENS=27000
GEMINI_EMBEDDING_CHUNK_TOKENS=500
GEMINI_EMBEDDING_CHUNK_OVERLAP_TOKENS=80

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
