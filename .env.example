# Copy this file to .env and adjust as needed.

# --- Database ---
POSTGRES_USER=slrms
POSTGRES_PASSWORD=slrms_password
POSTGRES_DB=slrms
DATABASE_URL=postgresql+psycopg2://slrms:slrms_password@db:5432/slrms

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET_KEY=super-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Optional: enable real LLM-based RAG answers instead of the local fallback ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
