# Public DNS records must point both names to the staging server.
APP_DOMAIN=staging.example.com
API_DOMAIN=api.staging.example.com
ACME_EMAIL=ops@example.com

# Database (use staging-only credentials and data).
POSTGRES_USER=slrms
POSTGRES_PASSWORD=replace-with-a-strong-staging-password
POSTGRES_DB=slrms
DATABASE_URL=postgresql+psycopg2://slrms:replace-with-a-strong-staging-password@db:5432/slrms

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Auth (generate a unique value with at least 32 characters).
JWT_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Private S3-compatible storage. These defaults use the bundled private MinIO.
STORAGE_BUCKET=slrms-staging-documents
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=replace-with-a-staging-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-a-strong-staging-storage-secret

# Browser-facing URLs. Keep the JSON array syntax for CORS_ORIGINS.
CORS_ORIGINS=["https://staging.example.com"]
NEXT_PUBLIC_API_URL=https://api.staging.example.com

# Optional AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TEXT_MODEL=
GEMINI_TIMEOUT_SECONDS=30
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIM=384
GEMINI_EMBEDDING_BATCH_TOKENS=27000
GEMINI_EMBEDDING_CHUNK_TOKENS=500
GEMINI_EMBEDDING_CHUNK_OVERLAP_TOKENS=80
